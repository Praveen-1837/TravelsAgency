# Aariva Voyages Backend Environment Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase (PostgreSQL, Auth, Storage)
SUPABASE_URL=https://your-project.supabase.co
# Note: SERVICE_ROLE_KEY MUST stay on the backend and NEVER be exposed to the client
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# SendGrid Email Delivery
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=inquiries@aarivavoyages.com
NOTIFICATION_EMAIL=ops@aarivavoyages.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10
